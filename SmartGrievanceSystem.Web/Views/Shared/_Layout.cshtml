<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartGrievanceSystem.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SmartGrievanceSystem.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/variables.css" asp-append-version="true" />`n</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">SmartGrievanceSystem.Web</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">`n                        @if (User.Identity.IsAuthenticated)`n                        {`n                            <li class="nav-item">`n                                <a class="nav-link text-dark" asp-area="" asp-controller="Grievance" asp-action="Index">My Grievances</a>`n                            </li>`n                            @if (User.IsInRole("Administrator") || User.IsInRole("Grievance Officer"))`n                            {`n                                <li class="nav-item">`n                                    <a class="nav-link text-dark" asp-area="" asp-controller="Admin" asp-action="Dashboard">Command Center</a>`n                                </li>`n                            }`n                        }`n                    </ul>`n                    <ul class="navbar-nav">`n                        @if (User.Identity.IsAuthenticated)`n                        {`n                            <li class="nav-item">`n                                <form asp-controller="Account" asp-action="Logout" method="post" class="form-inline">`n                                    <button type="submit" class="nav-link btn btn-link text-dark">Logout (@User.Identity.Name)</button>`n                                </form>`n                            </li>`n                        }`n                        else`n                        {`n                            <li class="nav-item">`n                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Login</a>`n                            </li>`n                            <li class="nav-item">`n                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Register">Register</a>`n                            </li>`n                        }`n                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - SmartGrievanceSystem.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>


