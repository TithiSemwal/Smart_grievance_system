@model IEnumerable<SmartGrievanceSystem.Core.Models.Grievance>
@{
    ViewData["Title"] = "Manage Grievances";
}

<div class="container mt-5 animate-fade-in">
    <h1 class="text-heading-lg mb-5">Triage Queue</h1>

    <div class="card p-0 overflow-hidden animate-fade-in delay-1">
        <table class="table mb-0">
            <thead class="bg-light">
                <tr class="transition-all hover-bg-tint">
                    <th class="text-body-sm text-stone-gray py-3 px-4 border-bottom-0">ID</th>
                    <th class="text-body-sm text-stone-gray py-3 px-4 border-bottom-0">Submitter</th>
                    <th class="text-body-sm text-stone-gray py-3 px-4 border-bottom-0">Title</th>
                    <th class="text-body-sm text-stone-gray py-3 px-4 border-bottom-0">AI Priority</th>
                    <th class="text-body-sm text-stone-gray py-3 px-4 border-bottom-0">Status</th>
                    <th class="border-bottom-0"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var ai = item.AIRecommendations?.OrderByDescending(a => a.RecommendationDate).FirstOrDefault();
                    <tr class="transition-all hover-bg-tint">
                        <td class="py-3 px-4 tabular-nums align-middle">@item.GrievanceCode</td>
                        <td class="py-3 px-4 align-middle font-weight-bold">@item.SubmitterUser.FullName</td>
                        <td class="py-3 px-4 align-middle">@item.Title</td>
                        <td class="py-3 px-4 align-middle">
                            @if (ai != null)
                            {
                                <span class="badge rounded-pill text-caption px-3 py-2" style="background-color: var(--color-warm-parchment); color: var(--color-ink-charcoal);">
                                    @ai.PredictedPriority (@Math.Round(ai.PriorityConfidenceScore * 100)%)
                                </span>
                            }
                            else
                            {
                                <span class="text-stone-gray">Pending AI</span>
                            }
                        </td>
                        <td class="py-3 px-4 align-middle">@item.Status</td>
                        <td class="py-3 px-4 align-middle text-end">
                            <a asp-controller="Grievance" asp-action="Details" asp-route-id="@item.GrievanceID" class="btn btn-secondary-lilac hover-lift">Triage</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

