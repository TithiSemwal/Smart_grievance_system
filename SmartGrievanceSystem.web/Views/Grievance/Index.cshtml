@model IEnumerable<SmartGrievanceSystem.Core.Models.Grievance>
@{
    ViewData["Title"] = "My Grievances";
}

<div class="container mt-5 animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h1 class="text-heading-lg">My Grievances</h1>
        <a asp-action="Create" class="btn btn-primary-wine">+ Submit New</a>
    </div>

    <div class="card p-0 overflow-hidden animate-fade-in delay-1">
        <table class="table mb-0">
            <thead class="bg-light">
                <tr class="transition-all hover-bg-tint">
                    <th class="text-body-sm text-stone-gray py-3 px-4 border-bottom-0">ID</th>
                    <th class="text-body-sm text-stone-gray py-3 px-4 border-bottom-0">Title</th>
                    <th class="text-body-sm text-stone-gray py-3 px-4 border-bottom-0">Status</th>
                    <th class="text-body-sm text-stone-gray py-3 px-4 border-bottom-0">Date</th>
                    <th class="border-bottom-0"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="transition-all hover-bg-tint">
                        <td class="py-3 px-4 tabular-nums align-middle">@item.GrievanceCode</td>
                        <td class="py-3 px-4 align-middle font-weight-bold">@item.Title</td>
                        <td class="py-3 px-4 align-middle">
                            <span class="badge rounded-pill text-caption px-3 py-2" style="background-color: var(--color-warm-parchment); color: var(--color-ink-charcoal); border: 1px solid var(--color-soft-mist);">
                                @item.Status
                            </span>
                        </td>
                        <td class="py-3 px-4 tabular-nums align-middle text-stone-gray text-body-sm">@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td class="py-3 px-4 align-middle text-end">
                            <a asp-action="Details" asp-route-id="@item.GrievanceID" class="inline-link font-weight-bold">View details &rarr;</a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr class="transition-all hover-bg-tint">
                        <td colspan="5" class="text-center py-5 text-stone-gray">You haven't submitted any grievances yet.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

