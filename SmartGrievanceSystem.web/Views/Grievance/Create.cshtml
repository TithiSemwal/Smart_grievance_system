@model SmartGrievanceSystem.Web.Models.GrievanceCreateViewModel
@{
    ViewData["Title"] = "Submit Grievance";
}

<div class="container mt-5 animate-fade-in">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h1 class="text-heading-lg mb-4">Submit a Grievance</h1>
            <p class="text-body-sm text-stone-gray mb-5">
                Describe your issue below. Our AI triage system will automatically analyze it and direct it to the right department.
            </p>

            <div class="card p-4 animate-fade-in delay-1">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Title" class="form-label text-label-bold">Title</label>
                        <input asp-for="Title" class="form-control" placeholder="Brief summary of the issue" />
                        <span asp-validation-for="Title" class="text-danger text-caption"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label text-label-bold">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="6" placeholder="Provide as much detail as possible..."></textarea>
                        <span asp-validation-for="Description" class="text-danger text-caption"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-3 mt-4">
                        <a asp-action="Index" class="btn btn-secondary-lilac hover-lift">Cancel</a>
                        <button type="submit" class="btn btn-primary-wine">Submit Grievance</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

